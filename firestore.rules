rules_version = '2';

// AI Dev Tracker
// - trackers/{uid}: each signed-in user's own data. Only that user can read or write it.
// - shares/{uid}:   optional read-only copy for a share link. Anyone can read it,
//                   only the owner can write or delete it.
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validDoc() {
      return request.resource.data.keys().hasOnly(['json', 'updated'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000
        && request.resource.data.updated == request.time;
    }

    match /trackers/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && validDoc();
    }
    match /shares/{uid} {
      allow get: if true;
      allow list: if false;
      allow delete: if owner(uid);
      allow create, update: if owner(uid) && validDoc();
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
