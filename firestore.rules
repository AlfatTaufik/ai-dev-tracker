rules_version = '2';

// AI Dev Tracker: every signed-in user owns exactly one document, trackers/{their uid}.
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /trackers/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json', 'updated'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000
        && request.resource.data.updated == request.time;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
